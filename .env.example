# VaporTech Rewards. Without these, local dev runs on a file store,
# a mock Clover register, SMS code 123456 and staff PIN 2468.
# In production every group below except Wallet is required.

# 1 = run on a live deploy without Twilio/Clover: code 123456, fake register, banner
REWARDS_TEST_MODE=

NEXT_PUBLIC_SITE_URL=https://www.smokecoralsprings.com
SESSION_SECRET=            # 32+ random chars
STAFF_PIN=                 # counter iPad PIN

# Supabase (run supabase/migrations/*.sql in order first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Verify (one-time sign-in codes only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Clover (private app on the VaporTech merchant; sandbox: https://apisandbox.dev.clover.com)
CLOVER_API_BASE=https://api.clover.com
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_WEBHOOK_AUTH=       # auth code from the Clover webhook settings

# Apple Wallet (optional; PEM strings, \n escapes ok)
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# Google Wallet (optional)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
